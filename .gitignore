# .gitignore for Slay Check

# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
slay-check
cmd/slay-check/slay-check
cmd/github-action/slay-check

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out
coverage.html

# Dependency directories (remove the comment below to include it)
vendor/

# Go workspace file
go.work

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs
*.log
logs/

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Configuration files with secrets
slay-check.yaml
config/local.yaml
config/production.yaml

# Build artifacts
bin/
release/
dist/

# Test artifacts
testdata/
coverage.out
coverage.html

# Temporary files
tmp/
temp/
*.tmp

# AI provider tokens (never commit these)
*.token
*.key
secrets/

# GitHub Actions artifacts
.github/workflows/local.yml

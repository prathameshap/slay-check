# Copy to .env in your project (optional — environment variables work too)
# Local + free with Ollama (after: slay-check setup && ollama pull llama3.2)
# SLAY_CHECK_AI_PROVIDER=ollama

# GitHub Models — free tier (GitHub PAT)
# SLAY_CHECK_AI_PROVIDER=github
# SLAY_CHECK_AI_TOKEN=ghp_your_pat_here

# OpenAI / Anthropic / etc.
# SLAY_CHECK_AI_PROVIDER=openai
# SLAY_CHECK_AI_TOKEN=sk-...

# PR review from your machine (optional)
# SLAY_CHECK_GITHUB_TOKEN=ghp_...
